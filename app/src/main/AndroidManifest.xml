<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".OcculltApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Occullt">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Occullt">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    
    <!-- Required: set your sentry.io project identifier (DSN) -->
    <meta-data android:name="io.sentry.dsn" android:value="https://f9ecfdcb37af5b225be020573deb7251@o4504759805476864.ingest.us.sentry.io/4511701911011328" />

    <!-- set up releases -->
    <meta-data android:name="io.sentry.release" android:value="${sentryRelease}" />
    <!-- set up sentry session tracking -->
    <meta-data android:name="io.sentry.session-tracking.timeout-interval-millis" android:value="60000" />
    <!-- interaction breadcrumbs disabled: detailed usage tracking conflicts with
         the app's self-hosted/privacy posture -->
    <meta-data android:name="io.sentry.traces.user-interaction.enable" android:value="false" />
    <!-- screenshots disabled: a crash screenshot in a photo-culling app is almost
         certainly a personal photo — must never be uploaded to Sentry -->
    <meta-data android:name="io.sentry.attach-screenshot" android:value="false" />
    <!-- view hierarchy disabled: can embed on-screen content/PII -->
    <meta-data android:name="io.sentry.attach-view-hierarchy" android:value="false" />

    <!-- low sample rate: enough signal for performance regressions without
         recording every session -->
    <meta-data android:name="io.sentry.traces.sample-rate" android:value="0.1" />
</application>

</manifest>
