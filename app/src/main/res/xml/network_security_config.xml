<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext HTTP is temporarily allowed so self-hosted Immich servers on
         plain http:// work. The x-api-key header is sent unencrypted in that
         case; the settings screen warns when an http:// URL is entered.
         Set this back to false to require HTTPS again. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
