<?xml version="1.0" encoding="utf-8"?><!--
   Applies to devices older than API 31; newer devices use data_extraction_rules.xml.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- The Preferences DataStore (files/datastore/) holds the Immich API key in
         plaintext; it must never leave the device via backup. -->
    <exclude domain="file" path="datastore/" />
</full-backup-content>
